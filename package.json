{
  "name": "@ikenxuan/xhshow-ts",
  "version": "1.2.0",
  "description": "XHS API signature generator",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ikenxuan/xhshow-ts.git"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/*",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "tsx --test tests/*.test.ts",
    "dev": "tsx watch src/dev.ts",
    "pub": "npm publish --access public"
  },
  "keywords": [
    "xhs",
    "signature",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "24.10.15",
    "axios": "npm:@karinjs/axios@^1.13.2",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}